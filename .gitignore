*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

#build output (IntelliJ out/ and Maven target/)
out/
/core/
/target/
/sound
/img
/desktop/
/.vscode/
/foot
src/main/resources/default-font.fnt
src/main/resources/default-font.png

# IDE state is per-machine — IntelliJ re-imports the project from pom.xml.
# Exception: runConfigurations/ is JetBrains' documented shared/team location (no
# machine-specific paths), so we keep the one Maven-backed Run config committed.
# NOTE: must ignore .idea/* (not .idea/) or git won't descend into it to apply the
# negation below — see https://git-scm.com/docs/gitignore#_pattern_format.
.idea/*
!.idea/runConfigurations/
*.iml

